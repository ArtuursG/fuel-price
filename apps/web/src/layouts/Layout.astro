---
import "../styles/global.css";
import Logo from "../components/Logo.astro";

interface Props {
	title: string;
	/** Shown by search engines and in link previews (messengers, social media). */
	description?: string;
}

const {
	title,
	description = "Latvijas degvielas un EV uzlādes cenas vienuviet: lētākā cena šodien, cenu vēsture, staciju karte un kalkulatori.",
} = Astro.props;

// The header row holds only what is used day to day; Tīkli, Avoti and Par are
// in the footer. Ten links used to take four rows above the content on a phone.
const NAV = [
	{ href: "/", label: "Šodien" },
	{ href: "/karte/", label: "Karte" },
	{ href: "/vesture/", label: "Vēsture" },
	{ href: "/ev/", label: "EV uzlāde" },
	{ href: "/kalkulators/", label: "Kalkulators" },
	{ href: "/pabraukt/", label: "Vai vērts pabraukt?" },
	{ href: "/parrobezu/", label: "Pārrobežu" },
];
const FOOTER_NAV = [
	{ href: "/tikli/", label: "Tīkli" },
	{ href: "/avoti/", label: "Avoti" },
	{ href: "/par/", label: "Par lapu un metodiku" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<html lang="lv">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="degvielas cenas" />
		<meta property="og:locale" content="lv_LV" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#saturs">Pāriet uz saturu</a>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-header__brand" href="/">
					<Logo />
					<span>degvielas cenas</span>
				</a>
				<nav aria-label="Galvenā navigācija" class="site-header__nav">
					{NAV.map((item) => (
						<a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
					))}
				</nav>
				<script is:inline>
					// On a narrow screen the row scrolls; bring the current page into view.
					(() => {
						const nav = document.currentScript?.previousElementSibling;
						const current = nav?.querySelector('[aria-current="page"]');
						if (nav && current && nav.scrollWidth > nav.clientWidth) {
							nav.scrollLeft = current.offsetLeft - nav.clientWidth / 2 + current.clientWidth / 2;
						}
					})();
				</script>
			</div>
		</header>
		<main id="saturs">
			{import.meta.env.DEV && <p class="preview-notice">Lokālais dizaina priekšskatījums. Cenas no saglabātajiem avotu paraugiem; tās nav aktuāls nolasījums.</p>}
			<slot />
		</main>
		<footer class="site-footer">
			<div class="site-footer__inner">
				<nav aria-label="Papildu navigācija" class="site-footer__nav">
					{FOOTER_NAV.map((item) => (
						<a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
					))}
				</nav>
				<p>
					Dati no tīklu oficiālajām lapām. Cenas ir informatīvas un konkrētā stacijā var atšķirties.
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.preview-notice { border-bottom: 1px solid var(--color-border); padding: 0.75rem 0; font-size: 0.8rem; color: var(--color-ink-muted); }
	.skip-link { position: absolute; top: -5rem; left: 1rem; padding: 0.75rem; background: white; z-index: 10; }
	.skip-link:focus { top: 0.5rem; }

	.site-header {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
	}
	.site-header__inner {
		max-width: 88rem;
		margin: 0 auto;
		padding: 0 1.25rem;
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		gap: 0 1.5rem;
		flex-wrap: wrap;
	}
	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 1rem 0;
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
		color: var(--color-ink);
		text-decoration: none;
	}
	.site-header__nav {
		position: relative;
		display: flex;
		gap: 1.25rem;
		font-size: 0.95rem;
	}
	/* Current page: ink colour and a bar along the header's bottom edge. */
	.site-header__nav a {
		display: flex;
		align-items: center;
		color: var(--color-ink-muted);
		text-decoration: none;
		white-space: nowrap;
		box-shadow: inset 0 -2px 0 transparent;
	}
	.site-header__nav a:hover {
		color: var(--color-ink);
	}
	.site-header__nav a[aria-current="page"] {
		color: var(--color-ink);
		font-weight: 600;
		box-shadow: inset 0 -2px 0 var(--color-pylon);
	}
	/* On a narrow screen the links are one horizontally scrolling row under
	   the mark instead of several wrapped rows. A fade at the right edge
	   shows that the row continues. */
	@media (max-width: 60rem) {
		.site-header__inner {
			padding: 0;
		}
		.site-header__brand {
			padding: 0.85rem 1.25rem 0.35rem;
		}
		.site-header__nav {
			flex: 1 0 100%;
			overflow-x: auto;
			scrollbar-width: none;
			padding: 0 1.25rem;
			mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
		}
		.site-header__nav::-webkit-scrollbar {
			display: none;
		}
		.site-header__nav a {
			padding: 0.6rem 0;
		}
		.site-header__nav a:last-child {
			padding-right: 2rem;
		}
	}
	main {
		max-width: 88rem;
		margin: 0 auto;
		padding: 0 1.25rem 3rem;
	}
	.site-footer {
		border-top: 1px solid var(--color-border);
		margin-top: 2rem;
		background: var(--color-surface);
	}
	.site-footer__inner {
		max-width: 88rem;
		margin: 0 auto;
		padding: 1.5rem 1.25rem 2rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		font-size: 0.875rem;
	}
	.site-footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.site-footer__nav a {
		color: var(--color-ink);
	}
	.site-footer__nav a[aria-current="page"] {
		font-weight: 600;
	}
	.site-footer p {
		margin: 0;
		color: var(--color-ink-muted);
	}
</style>
