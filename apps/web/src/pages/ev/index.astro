---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { formatPrice } from "../../lib/prices";
import { CONNECTOR_LABELS, getEvTariffSummary } from "../../lib/ev";
import { getSourceStatuses, STATUS_LABELS } from "../../lib/sources";

const [tariffs, allSources] = await Promise.all([getEvTariffSummary(env.DB), getSourceStatuses(env.DB)]);

// A network can already have real data from a DIFFERENT source than its own
// (e.g. Elektrum Drive's tariffs come via emobi-ev, not elektrum-ev, which
// itself was never fetched) -- exclude those so the page doesn't show a
// network as both priced above and "still being investigated" below.
const networksWithData = new Set(tariffs.map((t) => t.networkName));
const pendingEvSources = allSources.filter(
	(s) => s.kind === "ev" && s.status !== "active" && !(s.networkName && networksWithData.has(s.networkName)),
);
---

<Layout title="EV uzlāde - fuel-price">
	<h1>EV uzlāde</h1>

	{tariffs.length === 0 ? (
		<p class="intro">Vēl nav datu -- kolektors EV tarifus vēl nav nolasījis.</p>
	) : (
		<>
			<p class="intro">
				Lētākā zināmā cena katram tīklam un savienotāja tipam. Vienā tīklā dažādās vietās cena var atšķirties --
				šeit rādīta lētākā, ne vidējā.
			</p>
			<div class="table-wrap">
				<table>
					<caption class="sr-only">EV uzlādes tarifi pa tīkliem un savienotāju tipiem</caption>
					<thead>
						<tr>
							<th scope="col">Tīkls</th>
							<th scope="col">Savienotājs</th>
							<th scope="col">Strāva</th>
							<th scope="col">Lētākā cena</th>
							<th scope="col">Vietu skaits</th>
						</tr>
					</thead>
					<tbody>
						{tariffs.map((t) => (
							<tr>
								<th scope="row">{t.networkName}</th>
								<td>{t.connector ? (CONNECTOR_LABELS[t.connector] ?? t.connector) : "-"}</td>
								<td>{t.currentType}</td>
								<td>
									{t.minEnergyMilliPerKwh !== null && (
										<>{formatPrice(t.minEnergyMilliPerKwh)}&nbsp;&euro;/kWh</>
									)}
									{t.minEnergyMilliPerKwh !== null && t.minTimeMilliPerMin !== null && " / "}
									{t.minTimeMilliPerMin !== null && (
										<>{formatPrice(t.minTimeMilliPerMin)}&nbsp;&euro;/min</>
									)}
								</td>
								<td>{t.stationCount}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</>
	)}

	{pendingEvSources.length > 0 && (
		<>
			<h2>Citi EV tīkli</h2>
			<p class="intro">Tīkli, kuriem uzlādes tarifu nolase vēl nav ieviesta vai izpētīta.</p>
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th scope="col">Tīkls</th>
							<th scope="col">Statuss</th>
						</tr>
					</thead>
					<tbody>
						{pendingEvSources.map((source) => (
							<tr>
								<th scope="row">
									<a href={source.url} rel="noopener noreferrer" target="_blank">{source.networkName ?? source.id}</a>
								</th>
								<td><span class="badge" data-status={source.status}>{STATUS_LABELS[source.status]}</span></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</>
	)}
</Layout>

<style>
	.intro {
		color: var(--color-ink-muted);
		max-width: 42rem;
		margin: 0 0 1.5rem;
	}
	.table-wrap {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: 4px;
	}
	table {
		font-size: 0.9rem;
	}
	th,
	td {
		padding: 0.6rem 0.85rem;
		text-align: left;
		border-bottom: 1px solid var(--color-border);
		white-space: nowrap;
	}
	thead th {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-ink-muted);
		background: var(--color-surface);
	}
	tbody tr:last-child td,
	tbody tr:last-child th {
		border-bottom: none;
	}
	.badge {
		font-size: 0.75rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		color: var(--color-ink-muted);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
	}
</style>
