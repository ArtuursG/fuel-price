---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import PriceCard from "../components/PriceCard.astro";
import PriceTable from "../components/PriceTable.astro";
import { cheapest, getLastUpdated, getLatestFuelPrices, getPriceHistory, historyKey } from "../lib/prices";

const [products, lastUpdated, history] = await Promise.all([
	getLatestFuelPrices(env.DB),
	getLastUpdated(env.DB),
	getPriceHistory(env.DB),
]);

const mainProducts = products.filter((row) => ["P95", "P98", "DSL", "DSL_PLUS", "HVO", "LPG"].includes(row.product));
const otherProducts = products.filter((row) => !mainProducts.includes(row));

const networkCount = new Set(products.flatMap((row) => row.prices.map((p) => p.networkId))).size;


function formatUpdatedAt(iso: string): string {
    if (/^\d{4}-\d{2}-\d{2}$/.test(iso)) return new Date(`${iso}T00:00:00Z`).toLocaleDateString("lv-LV");
	return new Date(iso).toLocaleString("lv-LV", { timeZone: "Europe/Riga", dateStyle: "short", timeStyle: "short" });
}

const datasetJsonLd = {
	"@context": "https://schema.org",
	"@type": "Dataset",
	name: "Latvijas degvielas cenas",
	description: "Degvielas cenu salīdzinājums Latvijas uzpildes staciju tīklos, nolasīts no oficiālajām mājaslapām.",
	license: "https://creativecommons.org/publicdomain/zero/1.0/",
	...(lastUpdated ? { temporalCoverage: lastUpdated } : {}),
	creator: { "@type": "Organization", name: "fuel-price" },
};
---

<Layout title="Degvielas cenas šodien - fuel-price">
	<script type="application/ld+json" set:html={JSON.stringify(datasetJsonLd)} />

	{products.length === 0 ? (
		<section class="empty-state">
			<h1>Degvielas cenas šodien</h1>
			<p>Vēl nav datu -- kolektors avotus vēl nav nolasījis. Pārbaudi vēlāk.</p>
		</section>
	) : (
		<>
			<section class="hero" aria-labelledby="today-heading">
				<h1 id="today-heading">Degvielas cenu pārskats</h1>
				<p class="hero__meta">
					{networkCount} tīkli. {lastUpdated && <>Pēdējā veiksmīgā pārbaude {formatUpdatedAt(lastUpdated)}.</>}
				</p>
				<p class="section-note">Zemākās novērotās cenas pa produktiem. Vieta un cenas vecums norādīts pie katras cenas.</p>
				<div class="pylon-grid">
					{mainProducts.map((row) => {
						const price = cheapest(row);
						return (
							<PriceCard
								label={row.label}
								product={row.product}
								price={price}
								history={history.get(historyKey(price.networkId, price.scope, row.product))}
							/>
						);
					})}
				</div>
			</section>

			<section aria-labelledby="all-networks-heading">
				<h2 id="all-networks-heading">Salīdzinājums pa tīkliem</h2>
				<PriceTable products={mainProducts} />
                {otherProducts.length > 0 && <details class="other-products"><summary>CNG, AdBlue un citi produkti</summary><p>CNG cena norādīta par kilogramu. Agro dīzelis paredzēts lauksaimniecības tehnikai, nevis vieglajām automašīnām.</p><PriceTable products={otherProducts} /></details>}
			</section>
		</>
	)}
</Layout>

<style>
    .other-products { margin-top: 1.5rem; font-size: 0.85rem; }
    .other-products summary { cursor: pointer; padding: 0.75rem 0; color: var(--color-pylon); }
    .hero__meta, .section-note { color: var(--color-ink-muted); font-size: 0.85rem; }
    .hero__meta { margin: 0 0 2rem; }
    .section-note { margin: 0 0 0.75rem; }
    .pylon-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); border-top: 2px solid var(--color-ink); border-left: 1px solid var(--color-border); }
    .empty-state { color: var(--color-ink-muted); }
    @media (max-width: 420px) { .pylon-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
