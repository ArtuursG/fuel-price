---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import PriceCard from "../components/PriceCard.astro";
import PriceTable from "../components/PriceTable.astro";
import { cheapest, getLatestFuelPrices } from "../lib/prices";

const products = await getLatestFuelPrices(env.DB);
---

<Layout title="Degvielas cenas šodien - fuel-price">
	{products.length === 0 ? (
		<section class="empty-state">
			<h1>Degvielas cenas šodien</h1>
			<p>Vēl nav datu -- kolektors avotus vēl nav nolasījis. Pārbaudi vēlāk.</p>
		</section>
	) : (
		<>
			<section aria-labelledby="today-heading">
				<h1 id="today-heading">Šodien lētākā cena Rīgā</h1>
				<div class="pylon-grid">
					{products.map((row) => <PriceCard label={row.label} price={cheapest(row)} />)}
				</div>
			</section>

			<section aria-labelledby="all-networks-heading">
				<h2 id="all-networks-heading">Visi tīkli šodien</h2>
				<PriceTable products={products} />
			</section>
		</>
	)}
</Layout>

<style>
	h1 {
		font-size: 1.5rem;
		margin: 1.5rem 0 1rem;
	}
	h2 {
		font-size: 1.15rem;
		margin: 2.5rem 0 1rem;
	}
	.pylon-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 0.9rem;
	}
	.empty-state {
		color: var(--color-ink-muted);
	}
</style>
