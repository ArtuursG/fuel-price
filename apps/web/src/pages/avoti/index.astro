---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getSourceStatuses, kindLabel, RUN_STATUS_LABELS, STATUS_LABELS } from "../../lib/sources";

const sources = await getSourceStatuses(env.DB);

function formatRunAt(iso: string | null): string {
	if (!iso) return "vēl nav nolasīts";
	return new Date(iso).toLocaleString("lv-LV", { timeZone: "Europe/Riga", dateStyle: "short", timeStyle: "short" });
}
---

<Layout title="Avoti - degvielas cenas">
	<h1>Avoti</h1>
	<p class="intro">
		Katrs avots tiek nolasīts automātiski. Šeit redzams katra avota statuss un pēdējā nolasīšanas mēģinājuma
		rezultāts - arī tad, ja tas bijis neveiksmīgs.
	</p>

	<div class="table-wrap">
		<table>
			<thead>
				<tr>
					<th scope="col">Tīkls</th>
					<th scope="col">Veids</th>
					<th scope="col">Statuss</th>
					<th scope="col">Pēdējais nolasījums</th>
					<th scope="col">Rezultāts</th>
				</tr>
			</thead>
			<tbody>
				{sources.map((source) => (
					<tr>
						<th scope="row">
							<a href={source.url} rel="noopener noreferrer" target="_blank">{source.networkName ?? source.id}</a>
						</th>
						<td>{kindLabel(source.kind)}</td>
						<td><span class="badge" data-status={source.status}>{STATUS_LABELS[source.status]}</span></td>
						<td class="num">{formatRunAt(source.lastRunAt)}</td>
						<td>
							{source.lastRunStatus ? (
								<span class="badge" data-run={source.lastRunStatus}>{RUN_STATUS_LABELS[source.lastRunStatus]}</span>
							) : (
								<span class="table-dash">-</span>
							)}
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	<p class="note">
		"Nolasīts" ne vienmēr nozīmē jaunu cenu: bieži avots ir pārbaudīts, bet cena nav mainījusies. Jaunu cenu
		saglabājam tikai tad, kad tā tiešām mainās.
	</p>
</Layout>
