---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getLatestFuelPrices } from "../../lib/prices";
import { buildCityOrigins } from "../../lib/detour";
import fuelData from "../../../public/data/fuel-stations.json";

// Only networks that have BOTH real OSM station locations AND a real
// collected price - safe, confirmed name matches between OSM "brand" tags and
// our internal network ids, NOT guesses (see the formula note in
// lib/detour.ts). Neste/KOOL/Astarte/Gotika are in the OSM data but we have
// no price for them (not published, or the source is not implemented yet),
// so they are left out - unclear name variants (e.g. "Virāža A") are
// deliberately not mapped to any network.
const OSM_NETWORK_TO_ID: Record<string, string> = {
	"Circle K": "circlek",
	Viada: "viada",
	"AS VIADA Baltija": "viada",
	'AS "VIADA Baltija"': "viada",
	Virši: "virsi",
	"Virši-A": "virsi",
	Straujupīte: "straujupite",
};

const products = await getLatestFuelPrices(env.DB);

const stationsByNetwork = new Map<string, { lat: number; lon: number }[]>();
for (const station of fuelData.stations as { network: string; lat: number; lon: number }[]) {
	const networkId = OSM_NETWORK_TO_ID[station.network];
	if (!networkId || !Number.isFinite(station.lat) || !Number.isFinite(station.lon)) continue;
	const list = stationsByNetwork.get(networkId) ?? [];
	list.push({ lat: station.lat, lon: station.lon });
	stationsByNetwork.set(networkId, list);
}

// Products with a known price for AT LEAST 2 tracked networks - only then does
// a "nearest vs cheapest" comparison make sense.
const comparableProducts = products
	.map((row) => {
		const prices = new Map<string, number>();
		for (const price of row.prices) {
			if (!stationsByNetwork.has(price.networkId)) continue;
			if (!prices.has(price.networkId)) prices.set(price.networkId, price.priceMilli);
		}
		return { product: row.product, label: row.label, prices };
	})
	.filter((row) => row.prices.size >= 2);

const payload = {
	products: comparableProducts.map((row) => ({
		product: row.product,
		label: row.label,
		prices: Object.fromEntries(row.prices),
	})),
	stations: Object.fromEntries(stationsByNetwork),
	// The user can deny geolocation or the browser can block it; without an
	// alternative the page would then do nothing. A city centre is accurate
	// enough to compare how far one has to drive.
	cities: buildCityOrigins(fuelData.stations as {address?: string | null; lat: number; lon: number}[]),
};
const hasData = payload.products.length > 0;
---

<Layout title="Vai ir vērts pabraukt? - degvielas cenas">
	<h1>Vai ir vērts pabraukt?</h1>

	{!hasData ? (
		<p class="intro">Vēl nav pietiekami daudz datu šim salīdzinājumam - vajag vismaz divus tīklus ar zināmu cenu.</p>
	) : (
		<>
			<p class="intro">
				Salīdzina tavu tuvāko degvielas tīklu ar pašlaik lētāko zināmo. Attālums ir taisnes attālums &times; 1,3
				(ceļa tuvinājums, nevis precīzs maršruts). Aptver tikai tīklus, kuriem zināma gan cena, gan stacijas
				atrašanās vieta - <a href="/karte/">pilns staciju saraksts kartē</a>.
			</p>

			<form id="detour-form" class="detour-form">
				{/* The starting point comes first: nothing is calculated without it. */}
				<fieldset class="detour-origin">
					<legend>No kurienes brauksi?</legend>
					<div class="detour-origin__row">
						<button type="button" id="detour-locate" class="button button--primary">Izmantot manu atrašanās vietu</button>
						<span class="detour-origin__or">vai</span>
						<label class="field detour-origin__city">
							<span class="sr-only">Pilsēta</span>
							<select id="detour-city">
								<option value="">Izvēlies pilsētu</option>
								{payload.cities.map((city) => <option value={city.name}>{city.name}</option>)}
							</select>
						</label>
					</div>
				</fieldset>
				<div class="detour-params">
					<label class="field">
						Degviela
						<select id="detour-product">
							{payload.products.map((p) => <option value={p.product}>{p.label}</option>)}
						</select>
					</label>
					<label class="field">
						Uzpildīsi (l)
						<input id="detour-liters" type="number" value="40" min="1" step="1" inputmode="decimal" />
					</label>
					<label class="field">
						Patēriņš (l/100 km)
						<input id="detour-consumption" type="number" value="7" min="0.1" step="0.1" inputmode="decimal" />
					</label>
				</div>
			</form>
			<p id="detour-status" role="status" aria-live="polite" class="detour-status">
				Atrašanās vieta tiek izmantota tikai šajā lapā un netiek saglabāta.
			</p>

			<div id="detour-result" class="detour-result" hidden></div>

			<script id="detour-data" type="application/json" set:html={JSON.stringify(payload)} />
			<script>
				import {
					breakEvenExtraKm,
					detourNetSavingsMilli,
					extraRoundTripKm,
					haversineKm,
					nearestStation,
					roadDistanceEstimateKm,
				} from "../../lib/detour";
				import { formatMoney, formatPrice } from "../../lib/prices";

				interface Payload {
					products: { product: string; label: string; prices: Record<string, number> }[];
					stations: Record<string, { lat: number; lon: number }[]>;
					cities: { name: string; lat: number; lon: number }[];
				}

				// Distances with a decimal comma, like the rest of the site ("1,1 km", not "1.1 km").
				const kmFormat = new Intl.NumberFormat("lv-LV", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
				const km = (value: number) => kmFormat.format(value);

				const NETWORK_LABELS: Record<string, string> = {
					circlek: "Circle K",
					virsi: "Virši",
					viada: "Viada",
					straujupite: "Straujupīte",
				};

				const data: Payload = JSON.parse(document.getElementById("detour-data")!.textContent!);
				const productSelect = document.getElementById("detour-product") as unknown as HTMLSelectElement;
				const litersInput = document.getElementById("detour-liters") as HTMLInputElement;
				const consumptionInput = document.getElementById("detour-consumption") as HTMLInputElement;
				const locateButton = document.getElementById("detour-locate") as HTMLButtonElement;
				const status = document.getElementById("detour-status") as HTMLParagraphElement;
				const result = document.getElementById("detour-result") as HTMLDivElement;

				let origin: { lat: number; lon: number } | null = null;

				function render() {
					if (!origin) return;
					const product = data.products.find((p) => p.product === productSelect.value);
					if (!product) return;
					const liters = Number(litersInput.value) || 0;
					const consumption = Number(consumptionInput.value) || 0;

					const distances = Object.entries(product.prices).map(([networkId, priceMilli]) => {
						const stations = data.stations[networkId] ?? [];
						const nearest = nearestStation(origin!, stations);
						const straightKm = nearest ? haversineKm(origin!, nearest) : Infinity;
						return { networkId, priceMilli, roadKm: roadDistanceEstimateKm(straightKm) };
					});
					if (!distances.length) return;

					const nearest = distances.reduce((a, b) => (b.roadKm < a.roadKm ? b : a));
					const cheapest = distances.reduce((a, b) => (b.priceMilli < a.priceMilli ? b : a));

					result.hidden = false;
					if (nearest.networkId === cheapest.networkId) {
						result.innerHTML = `
							<div class="verdict" data-positive="true">
								<p class="verdict__label">Nav kur braukt</p>
								<p class="verdict__value">Tuvākais ir arī lētākais</p>
							</div>
							<p class="detour-note">Tavs tuvākais zināmais tīkls (${NETWORK_LABELS[nearest.networkId]}, ${formatPrice(nearest.priceMilli)}&nbsp;&euro;/l, ~${km(nearest.roadKm)}&nbsp;km) ir arī lētākais no salīdzinātajiem.</p>
						`;
						return;
					}

					const extraKm = extraRoundTripKm(cheapest.roadKm, nearest.roadKm);
					const savings = detourNetSavingsMilli(nearest.priceMilli, cheapest.priceMilli, liters, extraKm, consumption);
					const breakEven = breakEvenExtraKm(nearest.priceMilli, cheapest.priceMilli, liters, consumption);
					const worth = savings > 0;

					// The answer first and large; the calculation rows below it.
					result.innerHTML = `
						<div class="verdict" data-positive="${worth}">
							<p class="verdict__label">${worth ? "Ir vērts pabraukt" : "Nav vērts pabraukt"}</p>
							<p class="verdict__value">${worth ? "ietaupīsi" : "zaudēsi"} ${formatMoney(Math.abs(savings))}&nbsp;&euro;</p>
						</div>
						<dl class="detour-rows">
							<div><dt>Tuvākais</dt><dd>${NETWORK_LABELS[nearest.networkId]}, ${formatPrice(nearest.priceMilli)}&nbsp;&euro;/l, ~${km(nearest.roadKm)}&nbsp;km</dd></div>
							<div><dt>Lētākais</dt><dd>${NETWORK_LABELS[cheapest.networkId]}, ${formatPrice(cheapest.priceMilli)}&nbsp;&euro;/l, ~${km(cheapest.roadKm)}&nbsp;km</dd></div>
							<div><dt>Papildu ceļš turp un atpakaļ</dt><dd>~${km(extraKm)}&nbsp;km</dd></div>
						</dl>
						${breakEven !== null ? `<p class="detour-note">Atmaksājas, ja papildu ceļš turp un atpakaļ ir līdz ~${km(breakEven)}&nbsp;km.</p>` : ""}
						<p class="detour-note">Attālums ir tuvinājums (taisnes attālums &times; 1,3), ne precīzs maršruts. Balstīts uz OpenStreetMap staciju atrašanās vietām, ne uz katras konkrētās stacijas reālo cenu.</p>
					`;
				}

				const citySelect = document.getElementById("detour-city") as unknown as HTMLSelectElement;
				citySelect.addEventListener("change", () => {
					const city = data.cities.find((item) => item.name === citySelect.value);
					if (!city) {
						origin = null;
						status.textContent = "Izvēlies pilsētu vai izmanto savu atrašanās vietu.";
						result.hidden = true;
						return;
					}
					origin = { lat: city.lat, lon: city.lon };
					status.textContent = `Sākumpunkts: ${city.name} (pilsētas centrs).`;
					render();
				});

				locateButton.addEventListener("click", () => {
					if (!navigator.geolocation) {
						status.textContent = "Pārlūks neatbalsta atrašanās vietas noteikšanu.";
						return;
					}
					locateButton.disabled = true;
					status.textContent = "Gaida atrašanās vietas atļauju...";
					navigator.geolocation.getCurrentPosition(
						(position) => {
							origin = { lat: position.coords.latitude, lon: position.coords.longitude };
							citySelect.value = "";
							locateButton.disabled = false;
							status.textContent = "Atrašanās vieta noteikta.";
							render();
						},
						(error) => {
							locateButton.disabled = false;
							status.textContent =
								error.code === 1
									? "Atrašanās vietas piekļuve nav atļauta. Izvēlies pilsētu sarakstā."
									: "Atrašanās vietu neizdevās noteikt. Izvēlies pilsētu sarakstā.";
						},
						{ timeout: 12000, maximumAge: 60000, enableHighAccuracy: false },
					);
				});

				for (const input of [productSelect, litersInput, consumptionInput]) {
					input.addEventListener("input", render);
				}
			</script>
		</>
	)}
</Layout>

<style>
	.detour-form {
		max-width: 42rem;
	}
	.detour-origin {
		margin: 0 0 1.25rem;
		padding: 0;
		border: 0;
	}
	.detour-origin legend {
		padding: 0;
		margin-bottom: 0.5rem;
		font-weight: 600;
	}
	.detour-origin__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 0.85rem;
	}
	.detour-origin__or {
		color: var(--color-ink-muted);
		font-size: 0.85rem;
	}
	.detour-origin__city {
		flex: 1 1 12rem;
	}
	.detour-params {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 0.85rem;
	}
	.detour-status {
		font-size: 0.8rem;
		color: var(--color-ink-muted);
		margin: 0.75rem 0 1.5rem;
	}
	.detour-result {
		max-width: 42rem;
	}
	:global(.verdict) {
		padding: 1rem 1.15rem;
		border-radius: var(--radius);
		border-left: 4px solid var(--color-up);
		background: var(--color-surface);
	}
	:global(.verdict[data-positive="true"]) {
		border-left-color: var(--color-cheapest-border);
		background: var(--color-cheapest-bg);
	}
	:global(.verdict p) {
		margin: 0;
	}
	:global(.verdict__label) {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-up);
	}
	:global(.verdict[data-positive="true"] .verdict__label) {
		color: var(--color-cheapest-ink);
	}
	:global(.verdict__value) {
		font-size: clamp(1.6rem, 4vw, 2.2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	:global(.detour-rows) {
		margin: 1rem 0 0;
		border-top: 1px solid var(--color-border);
	}
	:global(.detour-rows > div) {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.9rem;
	}
	:global(.detour-rows dt) {
		color: var(--color-ink-muted);
	}
	:global(.detour-rows dd) {
		margin: 0;
		font-weight: 600;
	}
	:global(.detour-note) {
		font-size: 0.78rem;
		color: var(--color-ink-muted);
		margin: 0.75rem 0 0;
	}
</style>
