---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { getEvTariffSummary } from "../../lib/ev";
import { PRODUCT_FULL_LABELS, cheapest, getLatestFuelPrices } from "../../lib/prices";

// Tikai uz litru cenoti, uz ceļiem legāli degvielas veidi (sk. lib/prices.ts
// DSL_AGRO piezīmi - NEKAD nerādīt šeit). CNG izslēgts - tā cena ir par kg,
// ne litru, tāpēc nesader ar vienu kopīgu "L/100km" ievadlauku.
const CALC_FUEL_PRODUCTS = new Set(["P95", "P98", "DSL", "DSL_PLUS", "LPG"]);

const [allFuelRows, evSummary] = await Promise.all([getLatestFuelPrices(env.DB), getEvTariffSummary(env.DB)]);
const fuelRows = allFuelRows.filter((row) => CALC_FUEL_PRODUCTS.has(row.product));

const calcData = {
	fuel: fuelRows.map((row) => ({
		product: row.product,
		label: row.label,
		fullLabel: PRODUCT_FULL_LABELS[row.product] ?? row.label,
		priceMilli: cheapest(row).priceMilli,
	})),
	ev: evSummary
		.filter((t) => t.minEnergyMilliPerKwh !== null || t.minTimeMilliPerMin !== null)
		.map((t) => ({
			networkName: t.networkName,
			connector: t.connector,
			currentType: t.currentType,
			minEnergyMilliPerKwh: t.minEnergyMilliPerKwh,
			minTimeMilliPerMin: t.minTimeMilliPerMin,
			avgPowerKw: t.avgPowerKw,
		})),
};

const hasData = calcData.fuel.length > 0 || calcData.ev.length > 0;
---

<Layout title="Kalkulators - degvielas cenas">
	<h1>Degvielas kalkulators</h1>

	{!hasData ? (
		<p class="intro">Vēl nav datu - kolektors avotus vēl nav nolasījis.</p>
	) : (
		<>
			<p class="intro">
				Rēķina pēc pašreizējām lētākajām zināmajām cenām, tāpēc cenu nav jāmeklē citur. Rezultāti
				pārrēķinās uzreiz, mainot ievadi - nekas netiek sūtīts uz serveri.
			</p>

			<div class="calc-grid">
			<section class="calc-section">
				<h2>Cik maksās brauciens?</h2>

				<div class="inputs">
					<label>
						Attālums (km)
						<input type="number" id="trip-distance" value="100" min="0" step="1" />
					</label>
					<label>
						Patēriņš (l/100&nbsp;km)
						<input type="number" id="trip-consumption" value="7" min="0" step="0.1" />
					</label>
					<label>
						Degviela
						<select id="trip-product">
							{calcData.fuel.map((f) => <option value={f.product}>{f.fullLabel}</option>)}
						</select>
					</label>
					<label>
						Cena (&euro;/l)
						<input type="number" id="trip-price" value="0" min="0" step="0.001" />
					</label>
					<label>
						Tvertne (l)
						<input type="number" id="trip-tank" value="50" min="0" step="1" />
					</label>
				</div>

				<label class="checkbox">
					<input type="checkbox" id="trip-return" />
					Turp un atpakaļ
				</label>

				<div id="trip-results" class="trip-results" aria-live="polite"></div>

				<h3>Ikdienas brauciens</h3>
				<div class="inputs">
					<label>
						Kilometri dienā
						<input type="number" id="daily-km" value="40" min="0" step="1" />
					</label>
					<label>
						Dienu skaits
						<input type="number" id="daily-days" value="21" min="0" step="1" />
					</label>
				</div>
				<p id="daily-result" class="daily-result" aria-live="polite"></p>

				<p class="note">
					Cena sākotnēji ņemta no lētākā tīkla izvēlētajai degvielai, bet to var pārrakstīt ar savu.
					CO<sub>2</sub> ir aptuvens, rēķināts pēc degvielas veida oglekļa koeficienta, ne konkrēta auto.
				</p>
			</section>

			<section class="calc-section">
				<h2>Cik maksā nobraukt 100 km?</h2>
				<p class="intro">Salīdzina degvielu ar publisko un mājas EV uzlādi.</p>

			<div class="inputs">
				<label>
					Degvielas patēriņš (l/100&nbsp;km)
					<input type="number" id="fuel-consumption" value="7" min="0" step="0.1" />
				</label>
				<label>
					EV patēriņš (kWh/100&nbsp;km)
					<input type="number" id="ev-consumption" value="18" min="0" step="0.5" />
				</label>
				<label>
					Mājas elektrības cena (&euro;/kWh)
					<input type="number" id="home-price" value="0.20" min="0" step="0.01" />
				</label>
			</div>
			<p class="note">
				Vienāds patēriņš pieņemts visiem degvielas veidiem vienkāršības labad - reālais patēriņš atšķiras pēc
				degvielas veida. EV laika tarifiem (&euro;/min) izmantota savienotāja vidējā jauda, ne precīza vērtība.
			</p>

			<div id="results" class="results" aria-live="polite"></div>
			</section>
			</div>

			<script type="application/json" id="calc-data" set:html={JSON.stringify(calcData)} />
			<script>
				import {
					co2KgForLiters,
					costPerKmMilli,
					evEnergyCostPer100km,
					evTimeCostPer100km,
					fuelCostPer100km,
					litersForTrip,
					periodCostMilli,
					rangeKm,
					tripCostMilli,
				} from "../../lib/calculator";
				import { formatPrice } from "../../lib/prices";

				interface CalcData {
					fuel: { product: string; label: string; fullLabel: string; priceMilli: number }[];
					ev: {
						networkName: string;
						connector: string | null;
						currentType: "AC" | "DC";
						minEnergyMilliPerKwh: number | null;
						minTimeMilliPerMin: number | null;
						avgPowerKw: number | null;
					}[];
				}

				const dataEl = document.getElementById("calc-data");
				const data: CalcData = JSON.parse(dataEl?.textContent ?? "{}");

				const fuelInput = document.getElementById("fuel-consumption") as HTMLInputElement;
				const evInput = document.getElementById("ev-consumption") as HTMLInputElement;
				const homeInput = document.getElementById("home-price") as HTMLInputElement;
				const resultsEl = document.getElementById("results") as HTMLElement;

				const CONNECTOR_LABELS: Record<string, string> = { CCS2: "CCS2", CHADEMO: "CHAdeMO", TYPE2: "Type 2" };

				function render() {
					const fuelConsumption = Number(fuelInput.value) || 0;
					const evConsumption = Number(evInput.value) || 0;
					const homePriceMilli = (Number(homeInput.value) || 0) * 1000;

					const rows: { label: string; costMilli: number }[] = [];

					for (const f of data.fuel) {
						rows.push({ label: f.label, costMilli: fuelCostPer100km(f.priceMilli, fuelConsumption) });
					}

					for (const t of data.ev) {
						const connectorLabel = t.connector ? (CONNECTOR_LABELS[t.connector] ?? t.connector) : t.currentType;
						const label = `${t.networkName} (${connectorLabel})`;
						if (t.minEnergyMilliPerKwh !== null) {
							rows.push({ label, costMilli: evEnergyCostPer100km(t.minEnergyMilliPerKwh, evConsumption) });
						} else if (t.minTimeMilliPerMin !== null && t.avgPowerKw) {
							rows.push({
								label,
								costMilli: evTimeCostPer100km(t.minTimeMilliPerMin, t.avgPowerKw, evConsumption),
							});
						}
					}

					if (homePriceMilli > 0) {
						rows.push({ label: "Uzlāde mājās", costMilli: evEnergyCostPer100km(homePriceMilli, evConsumption) });
					}

					rows.sort((a, b) => a.costMilli - b.costMilli);

					resultsEl.innerHTML = rows
						.map(
							(r) => `
						<div class="result-row">
							<span class="result-label">${r.label}</span>
							<span class="result-cost">${formatPrice(r.costMilli)}&nbsp;&euro;</span>
						</div>
					`,
						)
						.join("");
				}

				for (const input of [fuelInput, evInput, homeInput]) {
					input.addEventListener("input", render);
				}
				render();

				// --- Brauciena kalkulators ---
				const distanceInput = document.getElementById("trip-distance") as HTMLInputElement;
				const tripConsumptionInput = document.getElementById("trip-consumption") as HTMLInputElement;
				// Workers tipi deklarē savu globālo `Element` (HTMLRewriter), kas
				// sajaucas ar DOM `Element` - tāpēc ne tiešs cast, ne
				// querySelector<T> neiet cauri. Pāreja caur `unknown` ir vienīgais
				// ceļš, kamēr abi `Element` sadzīvo vienā projektā.
				const productSelect = document.getElementById("trip-product") as unknown as HTMLSelectElement;
				const priceInput = document.getElementById("trip-price") as HTMLInputElement;
				const tankInput = document.getElementById("trip-tank") as HTMLInputElement;
				const returnInput = document.getElementById("trip-return") as HTMLInputElement;
				const dailyKmInput = document.getElementById("daily-km") as HTMLInputElement;
				const dailyDaysInput = document.getElementById("daily-days") as HTMLInputElement;
				const tripResultsEl = document.getElementById("trip-results") as HTMLElement;
				const dailyResultEl = document.getElementById("daily-result") as HTMLElement;

				const numberFormat = new Intl.NumberFormat("lv-LV", { maximumFractionDigits: 1 });

				function fillPriceFromProduct() {
					const match = data.fuel.find((f) => f.product === productSelect.value);
					if (match) priceInput.value = (match.priceMilli / 1000).toFixed(3);
				}

				function renderTrip() {
					const oneWayKm = Number(distanceInput.value) || 0;
					const distanceKm = returnInput.checked ? oneWayKm * 2 : oneWayKm;
					const consumption = Number(tripConsumptionInput.value) || 0;
					const priceMilli = (Number(priceInput.value) || 0) * 1000;
					const tank = Number(tankInput.value) || 0;

					const liters = litersForTrip(distanceKm, consumption);
					const totalMilli = tripCostMilli(distanceKm, consumption, priceMilli);
					const co2 = co2KgForLiters(liters, productSelect.value);
					const range = rangeKm(tank, consumption);

					const rows: { label: string; value: string }[] = [
						{ label: "Kopā", value: `${formatPrice(totalMilli)}&nbsp;&euro;` },
						{ label: "Degviela", value: `${numberFormat.format(liters)} l` },
						{ label: "Uz kilometru", value: `${formatPrice(costPerKmMilli(distanceKm, totalMilli))}&nbsp;&euro;` },
						{
							label: "Uz 100 km",
							value: `${formatPrice(fuelCostPer100km(priceMilli, consumption))}&nbsp;&euro;`,
						},
					];
					if (range > 0) {
						rows.push({ label: "Ar pilnu tvertni", value: `${numberFormat.format(range)} km` });
					}
					if (co2 !== null) {
						rows.push({ label: "CO2 (aptuveni)", value: `${numberFormat.format(co2)} kg` });
					}
					if (returnInput.checked) {
						rows.push({ label: "Rēķināts attālumam", value: `${numberFormat.format(distanceKm)} km` });
					}

					tripResultsEl.innerHTML = rows
						.map(
							(r) => `
						<div class="result-row">
							<span class="result-label">${r.label}</span>
							<span class="result-cost">${r.value}</span>
						</div>
					`,
						)
						.join("");

					const dailyKm = Number(dailyKmInput.value) || 0;
					const days = Number(dailyDaysInput.value) || 0;
					const periodMilli = periodCostMilli(dailyKm, days, consumption, priceMilli);
					dailyResultEl.innerHTML =
						days > 0 && dailyKm > 0
							? `${numberFormat.format(dailyKm * days)} km ${days} dienās izmaksās <strong>${formatPrice(periodMilli)}&nbsp;&euro;</strong>`
							: "";
				}

				productSelect.addEventListener("change", () => {
					fillPriceFromProduct();
					renderTrip();
				});
				for (const el of [
					distanceInput,
					tripConsumptionInput,
					priceInput,
					tankInput,
					returnInput,
					dailyKmInput,
					dailyDaysInput,
				]) {
					el.addEventListener("input", renderTrip);
				}
				fillPriceFromProduct();
				renderTrip();
			</script>
		</>
	)}
</Layout>

<style>
	.intro {
		color: var(--color-ink-muted);
		max-width: 42rem;
		margin: 0 0 1.5rem;
	}
	/* Divas kolonnas, kamēr vietas pietiek; šaurāk - cita zem citas. */
	.calc-grid {
		display: grid;
		gap: 2rem;
		align-items: start;
	}
	@media (min-width: 62rem) {
		.calc-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}
	}
	.calc-section {
		min-width: 0;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--color-border);
	}
	@media (min-width: 62rem) {
		.calc-section {
			padding-bottom: 0;
			border-bottom: none;
		}
		/* Blakus esot, ievadlauki vairs neietilpst trijās kolonnās. */
		.calc-section .inputs {
			grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		}
	}
	.calc-section:last-of-type {
		border-bottom: none;
	}
	.calc-section h3 {
		font-size: 1rem;
		margin: 1.75rem 0 0.75rem;
	}
	.checkbox {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		color: var(--color-ink-muted);
	}
	.inputs select {
		font-size: 1rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: var(--color-surface);
		color: var(--color-ink);
	}
	.trip-results {
		max-width: 34rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
	}
	.daily-result {
		margin: 0.5rem 0 0;
		font-size: 0.95rem;
	}
	.inputs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 1rem;
		max-width: 42rem;
		margin-bottom: 0.75rem;
	}
	.inputs label {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.85rem;
		color: var(--color-ink-muted);
	}
	.inputs input {
		font-family: var(--font-mono);
		font-size: 1rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: var(--color-surface);
		color: var(--color-ink);
	}
	.note {
		color: var(--color-ink-muted);
		font-size: 0.8rem;
		max-width: 42rem;
		margin: 0 0 2rem;
	}
	.results {
		max-width: 34rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		overflow: hidden;
	}
	:global(.result-row) {
		display: flex;
		justify-content: space-between;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.95rem;
	}
	:global(.result-row:last-child) {
		border-bottom: none;
	}
	:global(.result-cost) {
		font-family: var(--font-mono);
		font-weight: 600;
	}
</style>
