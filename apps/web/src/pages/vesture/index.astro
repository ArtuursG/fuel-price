---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PriceHistoryChart from "../../components/PriceHistoryChart.astro";
import { buildDailySeries, dayKeys, getProductHistory } from "../../lib/history";
import { PRODUCT_FULL_LABELS } from "../../lib/prices";

const DAYS = 30;
// Only the products where comparing networks is worthwhile. DSL_AGRO is not
// road-legal (see lib/prices.ts), so it is not here.
const CHART_PRODUCTS = ["P95", "P98", "DSL", "DSL_PLUS", "LPG"];

const days = dayKeys(DAYS, new Date());

const charts = await Promise.all(
	CHART_PRODUCTS.map(async (product) => {
		const rows = await getProductHistory(env.DB, product);
		return {
			product,
			label: PRODUCT_FULL_LABELS[product] ?? product,
			series: buildDailySeries(rows, days),
		};
	}),
);

const withData = charts.filter((c) => c.series.length > 0);
---

<Layout title="Cenu vēsture - degvielas cenas">
	<h1>Cenu vēsture</h1>

	<p class="intro">
		Kā katra tīkla cena mainījusies pēdējās {DAYS} dienās. Novieto kursoru uz grafika vai pieskaries tam, lai
		redzētu konkrētās dienas cenas.
	</p>

	{withData.length === 0 ? (
		<p class="notice">Vēl nav nevienas cenas, ko attēlot.</p>
	) : (
		<>
			<div id="product-tabs" class="product-tabs" hidden>
				<label class="field">
					Degviela
					<select id="product-select" data-remember="product">
						{withData.map((chart) => (
							<option value={chart.product}>{chart.label}</option>
						))}
					</select>
				</label>
			</div>

			{withData.map((chart) => (
				<section class="chart-section" data-product={chart.product}>
					<h2>{chart.label}</h2>
					<PriceHistoryChart series={chart.series} days={days} />
				</section>
			))}
		</>
	)}

	<script>
		import { rememberFields } from "../../scripts/remember-fields";

		// Without JS all charts stay stacked one under another - they are complete.
		// With JS they become one chart with a fuel selector, and the heading is
		// kept for screen readers only, since the selector already says the same.
		// The Workers global `Element` (HTMLRewriter) clashes with the DOM
		// `Element`, so this goes through `unknown`.
		const tabs = document.getElementById("product-tabs") as unknown as HTMLElement | null;
		const select = document.getElementById("product-select") as unknown as HTMLSelectElement | null;
		const panels = Array.from(document.querySelectorAll<HTMLElement>(".chart-section"));

		if (tabs && select && panels.length > 1) {
			tabs.hidden = false;
			for (const panel of panels) panel.querySelector("h2")?.classList.add("sr-only");
			// Opens on the driver's own fuel, if the calculator already knows it.
			rememberFields();

			const show = (product: string) => {
				for (const panel of panels) {
					panel.hidden = panel.dataset.product !== product;
				}
			};

			select.addEventListener("change", () => show(select.value));
			show(select.value);
		}
	</script>

	<p class="note">
		Cena tiek saglabāta tikai tad, kad tā mainās, tāpēc dienās bez izmaiņām grafikā turpinās iepriekšējā
		cena - tā tajās dienās arī bija spēkā. Pirms pirmā novērojuma līnija nesākas.
	</p>
</Layout>

<style>
	.notice {
		max-width: 48rem;
		padding: 0.75rem 0.9rem;
		margin: 0 0 1.5rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-pylon);
		background: var(--color-surface);
		font-size: 0.9rem;
	}
	.product-tabs {
		max-width: 16rem;
		margin-bottom: 1.5rem;
	}
	.chart-section {
		padding-bottom: 1.5rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}
	.chart-section h2 {
		margin-bottom: 0.75rem;
	}
</style>
