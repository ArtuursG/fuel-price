---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PriceHistoryChart from "../../components/PriceHistoryChart.astro";
import { buildDailySeries, dayKeys, getProductHistory } from "../../lib/history";
import { PRODUCT_FULL_LABELS } from "../../lib/prices";

const DAYS = 30;
// Tikai tie produkti, kuriem ir vērts salīdzināt tīklus. DSL_AGRO nav uz
// ceļiem legāls (sk. lib/prices.ts), tāpēc te tā nav.
const CHART_PRODUCTS = ["P95", "P98", "DSL", "DSL_PLUS", "LPG"];

const days = dayKeys(DAYS, new Date());

const charts = await Promise.all(
	CHART_PRODUCTS.map(async (product) => {
		const rows = await getProductHistory(env.DB, product);
		return {
			product,
			label: PRODUCT_FULL_LABELS[product] ?? product,
			series: buildDailySeries(rows, days),
		};
	}),
);

const withData = charts.filter((c) => c.series.length > 0);
---

<Layout title="Cenu vēsture - degvielas cenas">
	<h1>Degvielas cenu vēsture un dinamika ({DAYS} dienas)</h1>

	<p class="intro">
		Degvielas cenas Latvijā mainās teju katru dienu, sekojot naftas produktu vairumtirdzniecības kotācijām,
		akcīzes nodokļa izmaiņām un sezonālajam pieprasījumam. Grafikā var salīdzināt, kurš tīkls cenu paceļ
		pirmais un kurš to samazina lēnāk, kā arī sekot līdzi starpībai starp dīzeļdegvielu un 95. benzīnu.
	</p>

	{withData.length === 0 ? (
		<p class="notice">Vēl nav nevienas cenas, ko attēlot.</p>
	) : (
		<>
			<div id="product-tabs" class="product-tabs" hidden>
				<label for="product-select">Degviela</label>
				<select id="product-select">
					{withData.map((chart) => (
						<option value={chart.product}>{chart.label}</option>
					))}
				</select>
			</div>

			{withData.map((chart) => (
				<section class="chart-section" data-product={chart.product}>
					<h2>{chart.label}</h2>
					<PriceHistoryChart series={chart.series} days={days} />
				</section>
			))}
		</>
	)}

	<script>
		// Bez JS paliek visi grafiki cits zem cita - tie ir pilnvērtīgi.
		// Ar JS tie pārtop par vienu grafiku ar degvielas izvēli.
		// Workers globālais `Element` (HTMLRewriter) sajaucas ar DOM `Element`,
		// tāpēc ejam caur `unknown`.
		const tabs = document.getElementById("product-tabs") as unknown as HTMLElement | null;
		const select = document.getElementById("product-select") as unknown as HTMLSelectElement | null;
		const panels = Array.from(document.querySelectorAll<HTMLElement>(".chart-section"));

		if (tabs && select && panels.length > 1) {
			tabs.hidden = false;

			const show = (product: string) => {
				for (const panel of panels) {
					panel.hidden = panel.dataset.product !== product;
				}
			};

			select.addEventListener("change", () => show(select.value));
			show(select.value);
		}
	</script>

	<p class="note">
		Cena tiek saglabāta tikai tad, kad tā mainās, tāpēc dienās bez izmaiņām grafikā turpinās iepriekšējā
		cena - tā tajās dienās arī bija spēkā. Pirms pirmā novērojuma līnija nesākas.
	</p>
</Layout>

<style>
	.intro {
		color: var(--color-ink-muted);
		max-width: 48rem;
		margin: 0 0 1.25rem;
	}
	.notice {
		max-width: 48rem;
		padding: 0.75rem 0.9rem;
		margin: 0 0 1.5rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-pylon);
		background: var(--color-surface);
		font-size: 0.9rem;
	}
	.product-tabs {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1.5rem;
	}
	.product-tabs label {
		font-size: 0.85rem;
		color: var(--color-ink-muted);
	}
	.product-tabs select {
		font: inherit;
		font-size: 0.95rem;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		background: var(--color-surface);
		color: var(--color-ink);
	}
	.chart-section {
		padding-bottom: 1.5rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}
	.chart-section h2 {
		margin-bottom: 0.75rem;
	}
	.note {
		max-width: 48rem;
		color: var(--color-ink-muted);
		font-size: 0.8rem;
	}
</style>
