---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import PriceHistoryChart from "../../components/PriceHistoryChart.astro";
import { buildDailySeries, dayKeys, distinctDays, getProductHistory } from "../../lib/history";
import { PRODUCT_FULL_LABELS } from "../../lib/prices";

const DAYS = 30;
// Tikai tie produkti, kuriem ir vērts salīdzināt tīklus. DSL_AGRO nav uz
// ceļiem legāls (sk. lib/prices.ts), tāpēc te tā nav.
const CHART_PRODUCTS = ["P95", "P98", "DSL", "DSL_PLUS", "LPG"];

const days = dayKeys(DAYS, new Date());

const charts = await Promise.all(
	CHART_PRODUCTS.map(async (product) => {
		const rows = await getProductHistory(env.DB, product);
		return {
			product,
			label: PRODUCT_FULL_LABELS[product] ?? product,
			series: buildDailySeries(rows, days),
			collectedDays: distinctDays(rows),
		};
	}),
);

const withData = charts.filter((c) => c.series.length > 0);
const collectedDays = Math.max(0, ...charts.map((c) => c.collectedDays));
---

<Layout title="Cenu vēsture - degvielas cenas">
	<h1>Degvielas cenu vēsture un dinamika ({DAYS} dienas)</h1>

	<p class="intro">
		Degvielas cenas Latvijā mainās teju katru dienu, sekojot naftas produktu vairumtirdzniecības kotācijām,
		akcīzes nodokļa izmaiņām un sezonālajam pieprasījumam. Grafikā var salīdzināt, kurš tīkls cenu paceļ
		pirmais un kurš to samazina lēnāk, kā arī sekot līdzi starpībai starp dīzeļdegvielu un 95. benzīnu.
	</p>

	{collectedDays < DAYS && (
		<p class="notice">
			Vēsture vēl krājas: pagaidām savāktas <b>{collectedDays === 1 ? "1 diena" : `${collectedDays} dienas`}</b>.
			Grafiks aizpildīsies pats, kolektoram strādājot -- līdz tam līnijas ir īsas un secinājumus no tām
			vilkt vēl nevar.
		</p>
	)}

	{withData.length === 0 ? (
		<p class="notice">Vēl nav nevienas cenas, ko attēlot.</p>
	) : (
		<>
			<div id="product-tabs" class="product-tabs" role="group" aria-label="Degvielas veids" hidden>
				{withData.map((chart, i) => (
					<button
						type="button"
						class="product-tabs__button"
						data-product={chart.product}
						aria-pressed={i === 0 ? "true" : "false"}
					>
						{chart.label}
					</button>
				))}
			</div>

			{withData.map((chart) => (
				<section class="chart-section" data-product={chart.product}>
					<h2>{chart.label}</h2>
					<PriceHistoryChart series={chart.series} days={days} />
				</section>
			))}
		</>
	)}

	<script>
		// Bez JS paliek visi grafiki cits zem cita -- tie ir pilnvērtīgi.
		// Ar JS tie pārtop par vienu grafiku ar degvielas veida izvēli.
		// Workers globālais `Element` (HTMLRewriter) sajaucas ar DOM `Element`,
		// tāpēc querySelector atgriež tipu bez `hidden` -- ejam caur `unknown`.
		const tabs = document.getElementById("product-tabs") as unknown as HTMLElement | null;
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".product-tabs__button"));
		const panels = Array.from(document.querySelectorAll<HTMLElement>(".chart-section"));

		if (tabs && buttons.length > 1) {
			tabs.hidden = false;

			function select(product: string) {
				for (const panel of panels) {
					panel.hidden = panel.dataset.product !== product;
				}
				for (const button of buttons) {
					button.setAttribute("aria-pressed", String(button.dataset.product === product));
				}
			}

			for (const button of buttons) {
				button.addEventListener("click", () => {
					const product = button.dataset.product;
					if (product) select(product);
				});
			}

			const first = buttons[0].dataset.product;
			if (first) select(first);
		}
	</script>

	<p class="note">
		Cena tiek saglabāta tikai tad, kad tā mainās, tāpēc dienās bez izmaiņām grafikā turpinās iepriekšējā
		cena -- tā tajās dienās arī bija spēkā. Pirms pirmā novērojuma līnija nesākas.
	</p>
</Layout>

<style>
	.intro {
		color: var(--color-ink-muted);
		max-width: 48rem;
		margin: 0 0 1.25rem;
	}
	.notice {
		max-width: 48rem;
		padding: 0.75rem 0.9rem;
		margin: 0 0 1.5rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-pylon);
		background: var(--color-surface);
		font-size: 0.9rem;
	}
	.product-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.25rem;
	}
	.product-tabs__button {
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-bg);
		color: var(--color-ink-muted);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
	}
	.product-tabs__button:hover {
		border-color: var(--color-pylon);
		color: var(--color-pylon);
	}
	.product-tabs__button[aria-pressed="true"] {
		border-color: var(--color-pylon);
		background: var(--color-pylon);
		color: var(--color-pylon-ink);
	}
	.chart-section {
		padding-bottom: 1.5rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}
	.chart-section h2 {
		margin-bottom: 0.75rem;
	}
	.note {
		max-width: 48rem;
		color: var(--color-ink-muted);
		font-size: 0.8rem;
	}
</style>
