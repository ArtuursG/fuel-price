---
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";
import { COUNTRY_LABELS, getBorderComparison, type BorderCountry } from "../../lib/borders";
import { formatPrice } from "../../lib/prices";

const comparison = await getBorderComparison(env.DB);
const countries: BorderCountry[] = ["LV", "LT", "EE"];

function cheapestCountry(prices: Partial<Record<BorderCountry, number>>): BorderCountry | null {
	let min: BorderCountry | null = null;
	for (const c of countries) {
		const p = prices[c];
		if (p === undefined) continue;
		if (min === null || p < (prices[min] as number)) min = c;
	}
	return min;
}

// Difference from Latvia - the reader here wants to know whether it is
// cheaper across the border and by how much. Minus means cheaper than Latvia.
function diffFromLatvia(prices: Partial<Record<BorderCountry, number>>, country: BorderCountry): number | null {
	const lv = prices.LV;
	const other = prices[country];
	if (country === "LV" || lv === undefined || other === undefined) return null;
	return other - lv;
}

// A numeric date, because a written one ("14. septembris") in the sentence
// "nedēļā, kas sākas ..." would need the locative case, which Intl does not give.
function formatWeek(weekMonday: string): string {
	return new Date(`${weekMonday}T00:00:00Z`).toLocaleDateString("lv-LV", { timeZone: "UTC" });
}
---

<Layout title="Pārrobežu cenas - degvielas cenas" description="Degvielas vidējās cenas Latvijā, Lietuvā un Igaunijā vienā tabulā.">
	<h1>Latvija, Lietuva un Igaunija</h1>

	{comparison.rows.length === 0 ? (
		<p class="intro">Vēl nav datu - kolektors ES nedēļas biļetenu vēl nav nolasījis.</p>
	) : (
		<>
			<p class="intro">
				Valstu vidējās cenas ar nodokļiem nedēļā, kas sākas {formatWeek(comparison.weekMonday!)} Visas trīs
				valstis nāk no viena avota (Eiropas Komisijas nedēļas degvielas biļetens), tāpēc tās var salīdzināt
				savā starpā. Tās ir visas valsts vidējās cenas, nevis konkrētu tīklu šodienas cenas kā sākumlapā.
			</p>

			<div class="table-wrap">
				<table>
					<caption class="sr-only">Nedēļas vidējās degvielas cenas Latvijā, Lietuvā un Igaunijā</caption>
					<thead>
						<tr>
							<th scope="col">Produkts</th>
							{countries.map((c) => <th scope="col">{COUNTRY_LABELS[c]}</th>)}
						</tr>
					</thead>
					<tbody>
						{comparison.rows.map((row) => {
							const cheapest = cheapestCountry(row.prices);
							return (
								<tr>
									<th scope="row">{row.label}</th>
									{countries.map((c) => {
										const price = row.prices[c];
										const diff = diffFromLatvia(row.prices, c);
										return (
											<td class:list={["num", { cheapest: c === cheapest }]}>
												{price !== undefined ? <>{formatPrice(price)}&nbsp;&euro;</> : <span class="table-dash">-</span>}
												{diff !== null && (
													<span class="diff" data-direction={diff < 0 ? "down" : diff > 0 ? "up" : "same"}>
														{diff === 0 ? "kā LV" : `${diff < 0 ? "−" : "+"}${formatPrice(Math.abs(diff))} pret LV`}
													</span>
												)}
											</td>
										);
									})}
								</tr>
							);
						})}
					</tbody>
				</table>
			</div>

			<p class="note">
				Ikdienas Lietuvas staciju līmeņa dati (LEA) vēl nav pievienoti - kad tie būs pieejami, pievienosies
				precīzāks, ikdienas pārrobežu salīdzinājums šai nedēļas skata vietā.
			</p>
		</>
	)}
</Layout>

<style>
	.diff {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--color-ink-muted);
	}
	.diff[data-direction="down"] {
		color: var(--color-down);
	}
	.diff[data-direction="up"] {
		color: var(--color-up);
	}
</style>
