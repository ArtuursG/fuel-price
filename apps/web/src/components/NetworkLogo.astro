---
// A network's mark. The logo files are the networks' own brands, used only to
// recognise a network in the comparison; they are not ours and are not redrawn.
//
// When there is no file (e.g. Gotika's robots.txt forbids downloading
// anything), a letter tile in the network's colour is shown instead - the
// table still needs something of the same size, and an empty spot would look
// like an error.
import { logoForId } from "../lib/logos";

interface Props {
	networkId: string;
	networkName: string;
	size?: number;
}

const { networkId, networkName, size = 24 } = Astro.props as Props;

// Tile colours for networks without a logo file; the rest fall back to neutral.
const FALLBACK_COLORS: Record<string, string> = {};

const file = logoForId(networkId);
const initials = networkName.slice(0, 2).toUpperCase();
---

{
	file ? (
		<img class="network-logo" src={file} width={size} height={size} alt="" loading="lazy" style={`--logo-size: ${size}px`} />
	) : (
		<span
			class="network-logo network-logo--text"
			aria-hidden="true"
			style={`--logo-size: ${size}px; --logo-color: ${FALLBACK_COLORS[networkId] ?? "var(--color-neutral)"}`}
		>
			{initials}
		</span>
	)
}

<style>
	.network-logo {
		flex: none;
		width: var(--logo-size);
		height: var(--logo-size);
		object-fit: contain;
		vertical-align: middle;
	}
	.network-logo--text {
		display: inline-grid;
		place-items: center;
		border-radius: 3px;
		background: var(--logo-color);
		color: #fff;
		font-size: calc(var(--logo-size) * 0.42);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
</style>
