---
import { AGE_LABELS, ORIGIN_LABELS, formatPrice, formatObservedAt, type NetworkPrice } from "../lib/prices";
import { buildSparklinePath } from "../lib/sparkline";

interface Props {
	label: string;
	product: string;
	price: NetworkPrice;
	history?: number[];
}

const { label, price, history } = Astro.props as Props;
const sparklinePath = history ? buildSparklinePath(history) : null;

const changeDirection =
	price.changeMilli === null ? "unknown" : price.changeMilli < 0 ? "down" : price.changeMilli > 0 ? "up" : "same";
const changeText =
	price.changeMilli === null
		? "pirmā novērošana"
		: changeDirection === "same"
			? "nemainīga"
			: `${changeDirection === "down" ? "↓" : "↑"} ${formatPrice(Math.abs(price.changeMilli))} €`;

---

<article class="pylon" data-change={changeDirection}>
	<p class="pylon__label">{label}</p>
	<p class="pylon__price">
		{formatPrice(price.priceMilli)}<span class="pylon__unit">&euro;/l</span>
	</p>
	<p class="pylon__network">{price.networkName}</p>
	{sparklinePath && (
		<svg class="pylon__sparkline" viewBox="0 0 64 24" preserveAspectRatio="none" aria-hidden="true">
			<path d={sparklinePath} />
		</svg>
	)}
	<p class="pylon__change" data-change={changeDirection} title="Pret iepriekšējo novēroto cenu">{changeText}</p>
	<p class="pylon__meta">
		<span class="badge badge--age" data-age={price.age}>{AGE_LABELS[price.age]}</span>
		<span class="badge badge--origin">{price.origin ? ORIGIN_LABELS[price.origin] : "izcelsme nav zināma"}</span>
	</p>
    {price.scope === "network" ? <p class="pylon__details">Visā tīklā</p> : <details class="pylon__details"><summary>Apskatīt vietas</summary><p>{price.whereText ?? "Vieta nav norādīta"}</p></details>}
    <p class="pylon__details">Pirmoreiz novērota <time datetime={price.observedAt}>{formatObservedAt(price.observedAt)}</time></p>
    {price.sourceUrl && <a class="pylon__details" href={price.sourceUrl}>Oficiālais avots</a>}
</article>

<style>
    .pylon { padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
    .pylon p { margin: 0; }
    summary { cursor: pointer; color: var(--color-pylon); padding: 0.25rem 0; }
    details[open] p { padding: 0.25rem 0; }
    .pylon__label { font-size: 0.95rem; font-weight: 600; }
    .pylon__price { font-family: var(--font-mono); font-size: clamp(1.65rem, 3vw, 2.1rem); line-height: 1.3; letter-spacing: -0.06em; }
    .pylon__unit { font-family: var(--font-body); font-size: 0.75rem; color: var(--color-ink-muted); margin-left: 0.3rem; letter-spacing: 0; }
    .pylon__network { font-size: 0.85rem; }
    .pylon__sparkline { width: 100%; height: 1.25rem; margin: 0.25rem 0; }
    .pylon__sparkline path { fill: none; stroke: var(--color-pylon); stroke-width: 1.5; }
    .pylon__change { font-family: var(--font-mono); font-size: 0.75rem; }
    .pylon__change[data-change="down"] { color: var(--color-down); }
    .pylon__change[data-change="up"] { color: var(--color-up); }
    .pylon__meta { display: flex; flex-direction: column; font-size: 0.75rem; color: var(--color-ink-muted); }
    .badge--age[data-age="older"], .badge--age[data-age="unknown"] { color: var(--color-up); font-weight: 600; }
    .pylon__details { font-size: 0.72rem; overflow-wrap: anywhere; color: var(--color-ink-muted); }
    a.pylon__details { color: var(--color-pylon); margin-top: auto; padding-top: 0.4rem; }
</style>
