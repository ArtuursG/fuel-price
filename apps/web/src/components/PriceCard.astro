---
import PriceInfo from "./PriceInfo.astro";
import { formatPrice, type NetworkPrice } from "../lib/prices";
import {
	buildSparklineArea,
	buildSparklineBars,
	SPARKLINE_HEIGHT,
	SPARKLINE_STYLE,
	SPARKLINE_WIDTH,
} from "../lib/sparkline";

interface Props {
	label: string;
	product: string;
	price: NetworkPrice;
	history?: number[];
}

const { label, price, history } = Astro.props as Props;
// Formu nosaka SPARKLINE_STYLE (sk. lib/sparkline.ts) - pāreja uz
// stabiņiem ir tikai tās vērtības maiņa.
const sparkArea = history && SPARKLINE_STYLE === "area" ? buildSparklineArea(history) : null;
const sparkBars = history && SPARKLINE_STYLE === "bars" ? buildSparklineBars(history) : [];
const hasSpark = sparkArea !== null || sparkBars.length > 0;

const changeDirection =
	price.changeMilli === null ? "unknown" : price.changeMilli < 0 ? "down" : price.changeMilli > 0 ? "up" : "same";
const changeText =
	price.changeMilli === null
		? "pirmā novērošana"
		: changeDirection === "same"
			? "nemainīga"
			: `${changeDirection === "down" ? "↓" : "↑"} ${formatPrice(Math.abs(price.changeMilli))} €`;

---

<article class="pylon" data-change={changeDirection}>
	<p class="pylon__label">{label}</p>
	<p class="pylon__price">
		{formatPrice(price.priceMilli)}<span class="pylon__unit">&euro;/l</span>
	</p>
	<p class="pylon__network">{price.networkName}</p>
	{hasSpark && (
		<svg
			class="pylon__sparkline"
			viewBox={`0 0 ${SPARKLINE_WIDTH} ${SPARKLINE_HEIGHT}`}
			preserveAspectRatio="none"
			aria-hidden="true"
			data-direction={sparkArea?.direction ?? changeDirection}
		>
			{sparkArea?.area && <path class="pylon__sparkline-fill" d={sparkArea.area} />}
			{sparkArea?.line && <path class="pylon__sparkline-line" d={sparkArea.line} />}
			{sparkArea && (
				<circle class="pylon__sparkline-dot" cx={sparkArea.last.x} cy={sparkArea.last.y} r="2.2" />
			)}
			{sparkBars.map((bar) => (
				<rect
					class="pylon__sparkline-bar"
					data-direction={bar.direction}
					x={bar.x}
					y={bar.y}
					width={bar.width}
					height={bar.height}
				/>
			))}
		</svg>
	)}
	<div class="pylon__footer">
		<span class="pylon__change" data-change={changeDirection} title="Pret iepriekšējo novēroto cenu">{changeText}</span>
		<PriceInfo price={price} />
	</div>
</article>

<style>
    .pylon { padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
    .pylon p { margin: 0; }
    summary { cursor: pointer; color: var(--color-pylon); padding: 0.25rem 0; }
    details[open] p { padding: 0.25rem 0; }
    .pylon__label { font-size: 0.95rem; font-weight: 600; }
    .pylon__price { font-family: var(--font-mono); font-size: clamp(1.65rem, 3vw, 2.1rem); line-height: 1.3; letter-spacing: -0.06em; }
    .pylon__unit { font-family: var(--font-body); font-size: 0.75rem; color: var(--color-ink-muted); margin-left: 0.3rem; letter-spacing: 0; }
    .pylon__network { font-size: 0.85rem; }
    .pylon__sparkline { display: block; width: 100%; height: 1.35rem; margin: 0.3rem 0 0.1rem; overflow: visible; }
    /* Krāsa seko tam, vai cena kritusi vai kāpusi - tie paši marķieri, ko
       lieto izmaiņas teksts zemāk, lai abi neteiktu pretrunīgas lietas. */
    .pylon__sparkline { --spark: var(--color-pylon); }
    .pylon__sparkline[data-direction="down"] { --spark: var(--color-down); }
    .pylon__sparkline[data-direction="up"] { --spark: var(--color-up); }
    .pylon__sparkline-fill { fill: var(--spark); opacity: 0.14; stroke: none; }
    /* vector-effect tur līnijas biezumu vienādu, lai gan viewBox ir izstiepts. */
    .pylon__sparkline-line { fill: none; stroke: var(--spark); stroke-width: 1.5; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
    .pylon__sparkline-dot { fill: var(--spark); stroke: var(--color-bg); stroke-width: 1.2; }
    .pylon__sparkline-bar { fill: var(--color-pylon); }
    .pylon__sparkline-bar[data-direction="down"] { fill: var(--color-down); }
    .pylon__sparkline-bar[data-direction="up"] { fill: var(--color-up); }
    .pylon__footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: auto; padding-top: 0.35rem; }
    .pylon__change { font-family: var(--font-mono); font-size: 0.75rem; }
    .pylon__change[data-change="down"] { color: var(--color-down); }
    .pylon__change[data-change="up"] { color: var(--color-up); }
</style>
