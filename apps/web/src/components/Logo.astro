---
// Lapas zīme: degvielas piliens ar krītošu cenu stabiņu rindu. Apzināti
// vienkāršs, lai būtu salasāms arī 16px favicon izmērā.
interface Props {
	size?: number;
}

const { size = 26 } = Astro.props as Props;
---

<svg
	class="logo"
	width={size}
	height={size}
	viewBox="0 0 32 32"
	aria-hidden="true"
	focusable="false"
>
	<path
		class="logo__drop"
		d="M16 2.5c.5 0 .9.2 1.2.6 1.9 2.4 7.8 10.2 7.8 15.3a9 9 0 0 1-18 0C7 13.3 12.9 5.5 14.8 3.1c.3-.4.7-.6 1.2-.6z"
	></path>
	<g class="logo__bars">
		<rect x="10.4" y="15" width="3" height="8" rx="0.6"></rect>
		<rect x="14.5" y="17" width="3" height="6" rx="0.6"></rect>
		<rect x="18.6" y="19.5" width="3" height="3.5" rx="0.6"></rect>
	</g>
</svg>

<style>
	.logo {
		flex: none;
		display: block;
	}
	.logo__drop {
		fill: var(--color-pylon);
	}
	.logo__bars rect {
		fill: var(--color-bg);
	}
</style>
