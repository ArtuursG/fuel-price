# Copy to .dev.vars (which is in .gitignore) and fill in for local development.
# In production these are set with `wrangler secret put <NAME>`, not here.

# apps/ingest - POST /ingest HMAC signature (phase 3)
INGEST_SECRET=

# collector - where to send the data (phase 3)
INGEST_URL=http://localhost:8787/ingest

# collector - Telegram alerts (phase 3); if empty, the monitor writes to the log instead of sending
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# sources from the existing EV project, if they are carried over in phase 6 (see ev-charge-lv/.env.example)
TRANSPORTDATA_API_KEY=
OCM_API_KEY=
